{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "me",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "1c5b41eb-5214-4010-ad32-3efa7c547179","database_name": "me" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "7b07e07287c74520a98f977ac6e25e2a" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
